# Environment Configuration for BCI Interface
# Copy this file to .env and update values as needed

# ============================================================================
# TENSORFLOW CONFIGURATION
# ============================================================================
# Log level: 0 (all), 1 (info), 2 (warning), 3 (error)
TF_CPP_MIN_LOG_LEVEL=2

# GPU Configuration
# Set to 1 to enable GPU, 0 to use CPU only
CUDA_VISIBLE_DEVICES=0

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application name
APP_NAME=BCI-Interface

# Application environment
APP_ENV=production

# Logging level
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/bci.log

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================
# Default config file path
CONFIG_PATH=config.yaml

# Number of training epochs
TRAIN_EPOCHS=50

# Batch size for training
TRAIN_BATCH_SIZE=32

# Learning rate
TRAIN_LEARNING_RATE=0.001

# Early stopping patience
EARLY_STOPPING_PATIENCE=15

# ============================================================================
# DATA CONFIGURATION
# ============================================================================
# Raw data directory
DATA_RAW_DIR=data/raw

# Processed data directory
DATA_PROCESSED_DIR=data/processed

# Number of EEG channels
EEG_CHANNELS=8

# Sampling rate (Hz)
SAMPLING_RATE=250

# Number of classes
NUM_CLASSES=5

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Models directory
MODELS_DIR=models

# Model name prefix
MODEL_NAME_PREFIX=bci_model

# Save best model only
SAVE_BEST_ONLY=true

# ============================================================================
# REAL-TIME INFERENCE
# ============================================================================
# Real-time buffer size (samples)
REALTIME_BUFFER_SIZE=250

# Confidence threshold for predictions
CONFIDENCE_THRESHOLD=0.7

# Debounce count (consecutive predictions needed)
DEBOUNCE_COUNT=3

# Mouse control
# Movement distance per action (pixels)
MOUSE_MOVE_DISTANCE=50

# Cursor smoothing factor
CURSOR_SMOOTHING_ALPHA=0.3

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection (optional)
DB_HOST=postgres
DB_PORT=5432
DB_USER=bci_user
DB_PASSWORD=change_me
DB_NAME=bci_experiments

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# TensorBoard port
TENSORBOARD_PORT=6006

# Enable TensorBoard
TENSORBOARD_ENABLED=true

# Output directory for results
OUTPUT_DIR=outputs

# ============================================================================
# DATA GENERATION (Testing/Demo)
# ============================================================================
# Number of synthetic samples to generate for training
SYNTHETIC_SAMPLES=1000

# Random seed for reproducibility
RANDOM_SEED=42

# ============================================================================
# PHYSIONET DATASET
# ============================================================================
# PhysioNet subject IDs to download (comma-separated)
# Leave empty to use synthetic data
PHYSIONET_SUBJECTS=1,2,3,4,5

# PhysioNet download cache directory
PHYSIONET_CACHE_DIR=data/physionet

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# Maximum number of workers for data loading
NUM_WORKERS=4

# Mixed precision training
MIXED_PRECISION=false

# Distributed training
DISTRIBUTED=false

# ============================================================================
# DEBUGGING
# ============================================================================
# Enable debug mode
DEBUG=false

# Verbose output
VERBOSE=false

# Save training plots
SAVE_PLOTS=true

# Save confusion matrix
SAVE_CONFUSION_MATRIX=true

# ============================================================================
# DEPLOYMENT
# ============================================================================
# Server port (for API if applicable)
SERVER_PORT=8000

# Server host
SERVER_HOST=0.0.0.0

# ============================================================================
# NOTES
# ============================================================================
# - Change all placeholder values (e.g., DB_PASSWORD) before production use
# - For GPU support, ensure CUDA_VISIBLE_DEVICES matches available GPUs
# - Adjust memory limits in docker-compose.yml based on your hardware
# - Never commit .env file with sensitive information to version control
