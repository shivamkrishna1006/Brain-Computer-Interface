# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security
SECRET_KEY=change-me-in-production-secret-key-min-32-chars

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/webapp.log

# Paths
MODELS_DIR=../../models
DATA_DIR=../../data
OUTPUTS_DIR=../../outputs
UPLOAD_FOLDER=uploads
LOGS_DIR=../../logs

# EEG Configuration
EEG_SAMPLING_RATE=250
EEG_CHANNELS=8
EEG_BUFFER_SIZE=250

# WebSocket Configuration
SOCKETIO_CORS_ALLOWED_ORIGINS=*
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25

# Upload Configuration
MAX_CONTENT_LENGTH=52428800
UPLOAD_EXTENSIONS=csv,npy,h5,pkl

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Database Configuration (if needed)
SQLALCHEMY_DATABASE_URI=sqlite:///bci_app.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Session Configuration
PERMANENT_SESSION_LIFETIME=86400
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Model Configuration
MODEL_CLASSES=Left Hand,Right Hand,Both Hands,Both Feet,Tongue/Click
MODEL_INPUT_SHAPE=8,1000
MODEL_BATCH_SIZE=32

# Training Configuration
TRAINING_EPOCHS=50
TRAINING_BATCH_SIZE=32
TRAINING_LEARNING_RATE=0.001
TRAINING_VALIDATION_SPLIT=0.2
TRAINING_EARLY_STOPPING_PATIENCE=10

# API Configuration
API_VERSION=1.0.0
API_TIMEOUT=30
ENABLE_SWAGGER=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_REQUESTS=100
RATELIMIT_PERIOD=60

# File Upload
ALLOWED_UPLOAD_EXTENSIONS=.csv,.npy,.h5,.pkl
MAX_UPLOAD_FILE_SIZE=52428800

# Development Tools
FLASK_TOOLBAR_ENABLED=False
DEBUG_TB_INTERCEPT_REDIRECTS=False

# Email Configuration (if needed)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# External Services
ENABLE_AUTH=False
AUTH_TOKEN_SECRET=secret-key-for-auth-tokens

# Performance
ENABLE_COMPRESSION=True
COMPRESSION_LEVEL=6

# Monitoring
ENABLE_METRICS=False
SENTRY_DSN=

# Feature Flags
FEATURE_TRAINING=True
FEATURE_EVALUATION=True
FEATURE_LIVE_STREAMING=True
FEATURE_BATCH_PROCESSING=True
FEATURE_FILE_UPLOAD=True

# Deployment
ENVIRONMENT=development
APP_NAME=BCI Web App
APP_VERSION=1.0.0
DEPLOYMENT_ENV=local

# SSL/HTTPS (Production)
SSL_CERT_FILE=
SSL_KEY_FILE=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Celery Configuration (if using async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ENABLED=False

# Timezone
TZ=UTC
